{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topmobili.local/schemas/catalog-project-package.schema.json",
  "title": "CatalogProjectPackage manifest",
  "type": "object",
  "required": ["packageFormat", "packageVersion", "createdAt", "generator", "project", "policy", "document", "capabilities", "authoringKit", "report", "assets", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "packageFormat": { "const": "CatalogProjectPackage" },
    "packageVersion": { "const": "1.0.0" },
    "createdAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["name", "increment", "schemaVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "increment": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": ["assetMode"],
      "properties": {
        "assetMode": { "enum": ["strict", "assisted", "creative"] },
        "publicationGate": { "enum": ["draft", "publication"] }
      },
      "additionalProperties": true
    },
    "document": { "$ref": "#/$defs/pathDescriptor" },
    "catalogSource": { "$ref": "#/$defs/pathDescriptor" },
    "generationPlan": {
      "allOf": [
        { "$ref": "#/$defs/pathDescriptor" },
        { "type": "object", "required": ["planVersion"], "properties": { "planVersion": { "const": "1.1.0" } } }
      ]
    },
    "capabilities": {
      "allOf": [
        { "$ref": "#/$defs/pathDescriptor" },
        { "type": "object", "required": ["manifestVersion"], "properties": { "manifestVersion": { "type": "string" } } }
      ]
    },
    "authoringKit": {
      "type": "object",
      "required": ["root", "manifestPath", "version"],
      "properties": {
        "root": { "$ref": "#/$defs/safePath" },
        "manifestPath": { "$ref": "#/$defs/safePath" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "report": { "$ref": "#/$defs/pathDescriptor" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "pathDescriptor": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "$ref": "#/$defs/safePath" } },
      "additionalProperties": true
    },
    "file": {
      "type": "object",
      "required": ["path", "role", "mimeType", "size", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "role": { "enum": ["document", "capabilities", "report", "asset", "authoring-kit", "support"] },
        "mimeType": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1, "maximum": 26214400 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "role", "relatedProductIds", "sourceAssetIds", "method", "fidelity", "generator"],
      "properties": {
        "origin": { "enum": ["provided", "official", "derived", "generated", "placeholder"] },
        "role": { "type": "string", "minLength": 1 },
        "relatedProductIds": { "type": "array", "items": { "type": "string" } },
        "sourceAssetIds": { "type": "array", "items": { "type": "string" } },
        "method": { "type": "string", "minLength": 1 },
        "fidelity": { "enum": ["product-faithful", "deterministic", "conceptual", "decorative"] },
        "generator": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "required": ["status", "publishAllowed", "reviewedAt"],
      "properties": {
        "status": { "enum": ["publish-ready", "review-required", "draft-only", "missing", "optional-missing"] },
        "publishAllowed": { "type": "boolean" },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": ["id", "label", "path", "mimeType", "size", "sha256", "provenance", "approval"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "path": { "$ref": "#/$defs/safePath" },
        "mimeType": { "enum": ["image/svg+xml", "image/png", "image/jpeg", "image/webp"] },
        "size": { "type": "integer", "minimum": 1, "maximum": 26214400 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "approval": { "$ref": "#/$defs/approval" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
